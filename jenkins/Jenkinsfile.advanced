pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'myusername/devops-web-app'
        APP_VERSION = "1.0.${BUILD_NUMBER}"
        // Securely reference credentials stored in Jenkins Credentials Manager:
        // DOCKER_HUB_CREDS = credentials('dockerhub-login-secret')
    }

    stages {
        stage('1. Checkout Code from Git') {
            steps {
                echo "Pulling source code from repository..."
            }
        }

        stage('2. Build in Isolated Node.js Container') {
            // Runs this specific stage inside an isolated Node.js Docker container!
            agent {
                docker {
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps {
                echo "Running inside Node.js container..."
                sh 'node -v'
                sh 'echo "Simulating npm install & npm build..."'
            }
        }

        stage('3. Build & Tag Docker Image') {
            steps {
                echo "Building production image: ${DOCKER_IMAGE}:${APP_VERSION}..."
                // Real command in production:
                // sh "docker build -t ${DOCKER_IMAGE}:${APP_VERSION} ."
                // sh "docker tag ${DOCKER_IMAGE}:${APP_VERSION} ${DOCKER_IMAGE}:latest"
            }
        }

        stage('4. Secure Push to Docker Hub') {
            steps {
                echo "Logging into Docker Hub and pushing image..."
                /*
                 * In Production, withCredentials masks secrets so passwords NEVER leak in logs:
                 * 
                 * withCredentials([usernamePassword(credentialsId: 'dockerhub-login-secret', passwordVariable: 'DOCKER_PASS', usernameVariable: 'DOCKER_USER')]) {
                 *     sh 'echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin'
                 *     sh "docker push ${DOCKER_IMAGE}:${APP_VERSION}"
                 * }
                 */
            }
        }

        stage('5. Trigger Kubernetes Deployment') {
            steps {
                echo "Updating Kubernetes deployment with new image tag: ${APP_VERSION}..."
                // sh "kubectl set image deployment/web-app container-name=${DOCKER_IMAGE}:${APP_VERSION}"
            }
        }
    }

    post {
        always {
            echo "Cleaning up temporary workspace..."
        }
        success {
            echo "🎉 SUCCESS: Build #${BUILD_NUMBER} pushed to DockerHub & deployed to K8s!"
        }
        failure {
            echo "🚨 FAILURE: Pipeline failed on Build #${BUILD_NUMBER}."
        }
    }
}
